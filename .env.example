PORTAI_DATA_MODE=public_replay
PORTAI_APP_ENV=research
PORTAI_LIVE_DATA_VERIFIED=false
PORTAI_EXECUTION_ADAPTER_VERIFIED=false
PORTAI_DATASET_MANIFEST=backend/config/public_noaa_ais.json
PORTAI_ARTIFACTS_DIR=backend/artifacts
PORTAI_HOST=127.0.0.1
PORTAI_PORT=8000
PORTAI_MAX_CONCURRENT_TRAINING=1
PORTAI_MAX_TRAINING_TIMESTEPS=5000000
PORTAI_MAX_REQUEST_BYTES=262144
PORTAI_CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
PORTAI_ALLOW_BROWSER_LAUNCH=true

# Optional in research mode. Required in live/production mode; use 32+ random characters.
# PORTAI_API_KEY=replace-through-secret-manager

# Production-only; never commit real values.
# PORTAI_LIVE_SNAPSHOT_URL=https://port-gateway.example/api/situation/current
# PORTAI_LIVE_ALERTS_URL=https://port-gateway.example/api/alerts
# PORTAI_LIVE_GATEWAY_TOKEN=replace-through-secret-manager
# PORTAI_EXECUTION_ADAPTER_URL=https://port-gateway.example/api/decisions
# PORTAI_EXECUTION_ADAPTER_TOKEN=replace-through-secret-manager
